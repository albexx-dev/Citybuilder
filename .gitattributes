# Нормализация текстовых файлов в репозитории.
* text=auto

# Citybuilder: low-poly модели (.fbx) и короткие процедурные UI-звуки (.wav) ≤ 30 КБ
# хранятся напрямую в git (решение EPIC-20 шаг 1) для автономного клонирования без Git LFS.
*.fbx binary
*.wav binary

# Крупные бинарные ассеты — через LFS (паттерны на будущее).
*.obj filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
